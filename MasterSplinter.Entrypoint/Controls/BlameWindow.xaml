<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MasterSplinter.Entrypoint.Controls.BlameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:inf="using:MasterSplinter.Entrypoint.Infrastructure"
    mc:Ignorable="d"
    Title="Blame">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}"
          RowDefinitions="Auto,*,Auto">

        <!-- ===== Header: what is blamed, and the two knobs that change the answer ===== -->
        <Border Grid.Row="0" Background="{ThemeResource ToolAreaBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock x:Name="PathText" FontFamily="Consolas" FontSize="13"
                               Foreground="{ThemeResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="RevText" FontSize="11.5"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Mirrors TortoiseGit's detect-moved-or-copied ladder; each step costs git more
                     work, which is why it is opt-in rather than always on. -->
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Detect moved lines" FontSize="11"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <ComboBox x:Name="MovesBox" MinWidth="190" Height="30"
                              SelectionChanged="Options_Changed">
                        <ComboBoxItem Content="Off" />
                        <ComboBoxItem Content="Within this file (-M)" />
                        <ComboBoxItem Content="From modified files (-C)" />
                        <ComboBoxItem Content="From any file (-C -C)" />
                    </ComboBox>
                </StackPanel>

                <CheckBox Grid.Column="2" x:Name="IgnoreWsBox" Content="Ignore whitespace"
                          MinWidth="0" VerticalAlignment="Bottom" Margin="0,0,0,4"
                          Checked="Options_Changed" Unchecked="Options_Changed" />

                <Button Grid.Column="3" Content="Reload" VerticalAlignment="Bottom" Height="32"
                        Margin="0,0,0,2" Click="Reload_Click" />
            </Grid>
        </Border>

        <!-- ===== Body: the blamed lines, plus detail for the selected line's commit ===== -->
        <Grid Grid.Row="1" ColumnDefinitions="*,4,320">
            <!-- ItemsSource is assigned in code: x:Bind would make the XAML compiler generate
                 setters for BlameLine, and a positional record only has init accessors. -->
            <ListView x:Name="LinesList" Grid.Column="0" SelectionMode="Single" Padding="0"
                      SelectionChanged="Lines_SelectionChanged"
                      ScrollViewer.HorizontalScrollMode="Enabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- The gutter fields are blank on every line but the first of each
                             commit's run (see BlameLine.IsGroupStart), so a block of lines from
                             one commit reads as one block instead of the same text repeated. -->
                        <Grid ColumnDefinitions="76,132,84,52,*" Height="18">
                            <TextBlock Text="{Binding GutterSha}" FontFamily="Consolas" FontSize="11.5"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{ThemeResource BadgeLocalFg}" />
                            <TextBlock Grid.Column="1" Text="{Binding GutterAuthor}" FontSize="11.5"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding GutterDate}" FontSize="11.5"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextMutedBrush}" />
                            <TextBlock Grid.Column="3" Text="{Binding FinalLine}" FontFamily="Consolas"
                                       FontSize="11.5" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="0,0,10,0"
                                       Foreground="{ThemeResource TextMutedBrush}" />
                            <TextBlock Grid.Column="4" FontFamily="Consolas" FontSize="12.5"
                                       VerticalAlignment="Center" TextWrapping="NoWrap"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       inf:Syntax.Code="{Binding Text}"
                                       inf:Syntax.Lang="{Binding SourcePath, Converter={StaticResource PathToLang}}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Column="1" Background="{ThemeResource DividerBrush}" />

            <Border Grid.Column="2" Background="{ThemeResource PanelBackgroundBrush}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                        <TextBlock Text="SELECTED LINE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock x:Name="DetailEmpty" Text="Select a line to see the commit that wrote it."
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                        <StackPanel x:Name="DetailPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="DetailSummary" TextWrapping="Wrap" FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock x:Name="DetailSha" FontFamily="Consolas" FontSize="12"
                                       IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock x:Name="DetailAuthor" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock x:Name="DetailDate" FontSize="12"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock x:Name="DetailOrigin" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{ThemeResource TextMutedBrush}"
                                       Visibility="Collapsed" />
                            <Button x:Name="ShowInHistoryButton" Content="Show in History"
                                    HorizontalAlignment="Stretch" Click="ShowInHistory_Click" />
                            <Button Content="Blame at This Commit" HorizontalAlignment="Stretch"
                                    Click="BlameAtCommit_Click"
                                    ToolTipService.ToolTip="Re-blame the file as it was in this commit's parent state" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Footer: line count / status ===== -->
        <Border Grid.Row="2" Background="{ThemeResource FooterBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusText" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <ProgressRing Grid.Column="1" x:Name="Busy" IsActive="False" Width="16" Height="16" />
            </Grid>
        </Border>
    </Grid>
</Window>
